DOMAIN=open5gs.org

# RAN simulator(s) to start: ueransim, packetrusher, or both (comma-separated).
COMPOSE_PROFILES=ueransim

OPEN5GS_IMAGE=open5gs-base
MONGO_IMAGE=mongo:8
UERANSIM_IMAGE=free5gc/ueransim@sha256:f18956fad3b550c71811add94c25b07d2e75951a26d162ad7e25d945831394bf
EUPF_IMAGE=ghcr.io/edgecomllc/eupf@sha256:81cc197e6ad3aa6d4416ec3f9a457311378f179e221734c2a62722e52b528251

CORE_SUBNET=172.20.0.0/24
CORE_GATEWAY=172.20.0.1
CORE_BRIDGE=br-open5gs
CORE_DYNAMIC_RANGE=172.20.0.224/27

UE_SUBNET=10.60.0.0/16

MONGODB_IPV4_ADDRESS=172.20.0.10
WEBUI_IPV4_ADDRESS=172.20.0.20
NRF_IPV4_ADDRESS=172.20.0.30
SCP_IPV4_ADDRESS=172.20.0.40
AUSF_IPV4_ADDRESS=172.20.0.50
UDM_IPV4_ADDRESS=172.20.0.60
NSSF_IPV4_ADDRESS=172.20.0.70
PCF_IPV4_ADDRESS=172.20.0.80
BSF_IPV4_ADDRESS=172.20.0.90
UDR_IPV4_ADDRESS=172.20.0.100
SMF_IPV4_ADDRESS=172.20.0.110
AMF_IPV4_ADDRESS=172.20.0.120
# Must match n3_address in config/eupf.yaml.
UPF_IPV4_ADDRESS=172.20.0.130
GNB_IPV4_ADDRESS=172.20.0.140
UE_IPV4_ADDRESS=172.20.0.150
DN_IPV4_ADDRESS=172.20.0.155
# Must match gnodeb.controlif/dataif in config/packetrusher.yml.
PACKETRUSHER_IPV4_ADDRESS=172.20.0.160
# Handover target gNB: always the next address after PACKETRUSHER_IPV4_ADDRESS.
PACKETRUSHER_GNB2_IPV4_ADDRESS=172.20.0.161

# Host-published ports
UPF_API_PORT=8080
UPF_METRICS_PORT=9091
WEBUI_PORT=9999
